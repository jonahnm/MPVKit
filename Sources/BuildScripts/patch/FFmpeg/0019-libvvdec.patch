diff --git a/libavcodec/libvvdecdec.c b/libavcodec/libvvdecdec.c
new file mode 100644
index 0000000000..77f6c4caa3
--- /dev/null
+++ b/libavcodec/libvvdecdec.c
@@ -0,0 +1,412 @@
+/*
+ * VVC (Versatile Video Coding) decoder using the Fraunhofer vvdec library
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
