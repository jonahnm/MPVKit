+ * License along with FFmpeg; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#include <vvdec/vvdec.h>
+
+#include "libavutil/bswap.h"
+#include "libavutil/intreadwrite.h"
+#include "libavutil/bswap.h"
+#include "libavutil/intreadwrite.h"
+#include "libavutil/imgutils.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
+#include "libavutil/pixdesc.h"
+
+#include "avcodec.h"
+#include "codec_internal.h"
+#include "decode.h"
+#include "internal.h"
+
+typedef struct LibvvdecContext {
+    const AVClass *class;
+    vvdecDecoder *decoder;
+
+    int parse_delay;
+
+    /* NALs of the packet currently being fed to vvdec one at a time. */
+    uint8_t *pending_buf;
+    int pending_size;
+    int pending_off;
+    uint8_t flush_buf[4];
+} LibvvdecContext;
+
+static void libvvdec_log(void *opaque, int level, const char *msg, va_list args)
+{
+    /* The va_list handed to this callback is not usable from C (the vvdec
+     * library passes it through a std::function, which mangles the aarch64
+     * __va_list). Never dereference it; vvdec logs diagnostics to stderr
+     * on its own when no callback is installed, so keep this a no-op. */
+}
+
+static av_cold int libvvdec_init(AVCodecContext *avctx)
+{
+    LibvvdecContext *ctx = avctx->priv_data;
+    vvdecParams params;
+
+    vvdec_params_default(&params);
+    params.threads    = avctx->thread_count > 1 ? avctx->thread_count : -1;
+    params.parseDelay = ctx->parse_delay;
+    params.logLevel   = VVDEC_WARNING;
+    if (params.threads < 0 || params.threads > 4)
+        params.threads = 4;
+    if (params.parseDelay < 0 || params.parseDelay > 1)
+        params.parseDelay = 1;
+
+    ctx->decoder = vvdec_decoder_open(&params);
+    if (!ctx->decoder)
+        return AVERROR_EXTERNAL;
+
+    avctx->pix_fmt = AV_PIX_FMT_YUV420P10LE;
+    vvdec_set_logging_callback(ctx->decoder, libvvdec_log);
+
+    return 0;
+}
+
+static av_cold int libvvdec_close(AVCodecContext *avctx)
+{
+    LibvvdecContext *ctx = avctx->priv_data;
+
+    if (ctx->decoder)
+        vvdec_decoder_close(ctx->decoder);
+    ctx->decoder = NULL;
+
+    return 0;
+}
+
+static void libvvdec_flush(AVCodecContext *avctx)
+{
+    LibvvdecContext *ctx = avctx->priv_data;
+    vvdecAccessUnit au = { 0 };
+    vvdecFrame *frame = NULL;
+
+    if (!ctx->decoder)
+        return;
+
+    ctx->pending_buf = NULL;
+    ctx->pending_size = 0;
+    ctx->pending_off = 0;
+
+    /* vvdec delivers frames held by the reorder buffer only when an access
+     * unit with an empty payload is decoded (vvdecapp's EOF flush). Use an
+     * empty AU instead of vvdec_flush so those frames are produced; they
+     * are discarded here (the decoder wrapper delivers them at stream end
+     * through the null-packet decode path). */
+    au.payload = (unsigned char *)ctx->flush_buf;
+    au.payloadSize = sizeof(ctx->flush_buf);
+    au.payloadUsedSize = 0;
+    while (vvdec_decode(ctx->decoder, &au, &frame) == VVDEC_EOF && frame)
+        frame = NULL;
+}
+
+static enum AVPixelFormat vvdec_pixel_format(const vvdecFrame *frame)
+{
+    switch (frame->colorFormat) {
+    case VVDEC_CF_YUV400_PLANAR:
+        if (frame->bitDepth <= 8)
+            return AV_PIX_FMT_GRAY8;
+        if (frame->bitDepth <= 10)
+            return AV_PIX_FMT_GRAY10LE;
+        return AV_PIX_FMT_GRAY12LE;
+    case VVDEC_CF_YUV420_PLANAR:
+        if (frame->bitDepth <= 8)
+            return AV_PIX_FMT_YUV420P;
+        if (frame->bitDepth <= 10)
+            return AV_PIX_FMT_YUV420P10LE;
+        return AV_PIX_FMT_YUV420P12LE;
+    case VVDEC_CF_YUV422_PLANAR:
+        if (frame->bitDepth <= 8)
+            return AV_PIX_FMT_YUV422P;
+        if (frame->bitDepth <= 10)
+            return AV_PIX_FMT_YUV422P10LE;
+        return AV_PIX_FMT_YUV422P12LE;
+    case VVDEC_CF_YUV444_PLANAR:
+        if (frame->bitDepth <= 8)
+            return AV_PIX_FMT_YUV444P;
+        if (frame->bitDepth <= 10)
+            return AV_PIX_FMT_YUV444P10LE;
+        return AV_PIX_FMT_YUV444P12LE;
+    default:
+        return AV_PIX_FMT_NONE;
+    }
+}
+
+static int libvvdec_copy_frame(AVCodecContext *avctx, AVFrame *frame,
+                               const vvdecFrame *src)
+{
+    const AVPixFmtDescriptor *desc;
+    int ret, plane;
+
+    frame->format = vvdec_pixel_format(src);
+    if (frame->format == AV_PIX_FMT_NONE)
+        return AVERROR_INVALIDDATA;
+
+    frame->width  = src->width;
+    frame->height = src->height;
+    /* vvdec's cts is undefined when the AU had ctsValid=false; leave the
+     * frame timestamp unset so the caller derives timing from the packet. */
+    frame->pts = AV_NOPTS_VALUE;
+
+    ret = ff_get_buffer(avctx, frame, 0);
+    if (ret < 0)
+        return ret;
+
+    desc = av_pix_fmt_desc_get(frame->format);
+    if (!desc)
+        return AVERROR_INVALIDDATA;
+
+    for (plane = 0; plane < FFMIN(src->numPlanes, 4); plane++) {
+        const vvdecPlane *src_plane = &src->planes[plane];
+        int h = src_plane->height;
+        ptrdiff_t linesize = FFMIN(src_plane->stride, frame->linesize[plane]);
+
+        for (int y = 0; y < h; y++)
+            memcpy(frame->data[plane] + y * frame->linesize[plane],
+                   src_plane->ptr + y * src_plane->stride, linesize);
+    }
+
+    return 0;
+}
+
+static int libvvdec_decode(AVCodecContext *avctx, AVFrame *frame,
+                           int *got_frame, AVPacket *avpkt)
+{
+    LibvvdecContext *ctx = avctx->priv_data;
+    vvdecAccessUnit au = { 0 };
+    vvdecFrame *vframe = NULL;
+    int ret = 0;
+
+    if (avpkt->size) {
+        const uint8_t *data = avpkt->data;
+        int size = avpkt->size;
+        uint8_t *buf = NULL;
+
+        /* Annex-B (start-code) detection: accept both 3-byte and 4-byte
+         * start codes. A leading 0x00000001 is ambiguous (it could be a
+         * length prefix of 1), so require a second start code further in
+         * before treating the packet as Annex-B. */
+        int annexb = 0;
+        if (size >= 4 && AV_RB32(data) == 1) {
+            for (int i = 4; i + 3 < size; i++) {
+                if (data[i] == 0 && data[i + 1] == 0) {
+                    if (data[i + 2] == 0 && data[i + 3] == 1) {
+                        annexb = 1;
+                        break;
+                    }
+                    if (data[i + 2] == 1 && (i == 0 || data[i - 1] != 0)) {
+                        annexb = 1;
+                        break;
+                    }
+                }
+            }
+        } else if (size >= 3 && AV_RB24(data) == 1) {
+            /* 3-byte start code. A leading 00 00 01 xx can also read as a
+             * length prefix of 256+xx; treat it as a start code when the
+             * NAL byte that follows (0x00) forms a valid base-layer NAL
+             * header, otherwise fall through to the length-prefix path. */
+            if (size < 4 || data[3] == 0)
+                annexb = 1;
+        }
+
+        if (!annexb) {
+            int nal_length_size = 4;
+            if (size >= 4 && AV_RB32(data) <= size - 4 && AV_RB32(data) > 0)
+                nal_length_size = 4;
+            else if (size >= 2 && AV_RB16(data) <= size - 2 && AV_RB16(data) > 0)
+                nal_length_size = 2;
+
+            buf = av_malloc(size + size / 2 + 64);
+            if (!buf)
+                return AVERROR(ENOMEM);
+
+            size = 0;
+            while (avpkt->data + avpkt->size - data >= nal_length_size) {
+                int nalsize = nal_length_size == 4 ? AV_RB32(data) : AV_RB16(data);
+                data += nal_length_size;
+                if (nalsize <= 0 || nalsize > avpkt->data + avpkt->size - data)
+                    break;
+                /* Skip enhancement-layer NALs (nuh_layer_id != 0): vvdec
+                 * rejects non-base-layer VCL NALs (IRAP with TemporalId != 0
+                 * is a conformance violation). */
+                if (nalsize >= 2 && ((data[0] & 0x3f) != 0))
+                    ;
+                else {
+                    buf[size++] = 0;
+                    buf[size++] = 0;
+                    buf[size++] = 0;
+                    buf[size++] = 1;
+                    memcpy(buf + size, data, nalsize);
+                    size += nalsize;
+                }
+                data += nalsize;
+            }
+            data = buf;
+        } else {
+            /* Deliver the payload from a fresh buffer so vvdec never sees
+             * FFmpeg's internal packet storage. */
+            buf = av_malloc(size + AV_INPUT_BUFFER_PADDING_SIZE);
+            if (!buf)
+                return AVERROR(ENOMEM);
+            memcpy(buf, data, size);
+            data = buf;
+        }
+
+        if (size == 0) {
+            av_free(buf);
+            return 0;
+        }
+
+        /* vvdec expects one NAL per access unit (vvdecapp feeds each NAL
+         * separately); AUs that bundle several NALs are rejected. Store the
+         * packet's NALs and consume them one at a time. */
+        ctx->pending_buf = (uint8_t *)data;
+        ctx->pending_size = size;
+        ctx->pending_off = 0;
+    }
+
+    /* Feed NALs from the current packet one at a time. */
+    while (ctx->pending_off < ctx->pending_size) {
+        uint8_t *data = ctx->pending_buf;
+        int pos = ctx->pending_off;
+        int next = ctx->pending_size;
+
+        if (pos >= ctx->pending_size)
+            break;
+
+        /* Skip leading bytes until the next start code. */
+        if (!(pos + 3 < ctx->pending_size && data[pos] == 0 &&
+              data[pos + 1] == 0 && data[pos + 2] == 1)) {
+            for (int i = pos; i + 3 < ctx->pending_size; i++) {
+                if (data[i] == 0 && data[i + 1] == 0 &&
+                    (data[i + 2] == 0 && data[i + 3] == 1)) {
+                    pos = i;
+                    break;
+                }
+                if (data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1 &&
+                    (i == 0 || data[i - 1] != 0)) {
+                    pos = i;
+                    break;
+                }
+            }
+        }
+        /* Find the end of this NAL (next start code). */
+        for (int j = pos + 3; j + 3 < ctx->pending_size; j++) {
+            if (data[j] == 0 && data[j + 1] == 0 &&
+                (data[j + 2] == 0 && data[j + 3] == 1)) {
+                next = j;
+                break;
+            }
+            if (data[j] == 0 && data[j + 1] == 0 && data[j + 2] == 1 &&
+                data[j - 1] != 0) {
+                next = j;
+                break;
+            }
+        }
+        if (next <= pos)
+            next = ctx->pending_size;
+
+        au.payload = data + pos;
+        au.payloadSize = next - pos;
+        au.payloadUsedSize = next - pos;
+        au.ctsValid = false;
+        au.dtsValid = false;
+        au.rap = avpkt->flags & AV_PKT_FLAG_KEY;
+
+        ctx->pending_off = next;
+
+        ret = vvdec_decode(ctx->decoder, &au, &vframe);
+        if (ret < 0 && ret != VVDEC_TRY_AGAIN && ret != VVDEC_ERR_DEC_INPUT &&
+            ret != VVDEC_ERR_RESTART_REQUIRED) {
+            av_free(ctx->pending_buf);
+            ctx->pending_buf = NULL;
+            ctx->pending_off = ctx->pending_size;
+            return AVERROR_EXTERNAL;
+        }
+
+        if (vframe) {
+            ret = libvvdec_copy_frame(avctx, frame, vframe);
+            vvdec_frame_unref(ctx->decoder, vframe);
+            av_free(ctx->pending_buf);
+            ctx->pending_buf = NULL;
+            ctx->pending_off = ctx->pending_size;
+            if (ret < 0)
+                return ret;
+            *got_frame = 1;
+            return 0;
+        }
+    }
+
+    if (ctx->pending_buf) {
+        av_free(ctx->pending_buf);
+        ctx->pending_buf = NULL;
+        ctx->pending_off = ctx->pending_size;
+    }
+
+    if (!avpkt->size) {
+        /* Flush: vvdec hands out frames held by the reorder buffer when an
+         * empty access unit is decoded (same as vvdecapp's EOF flush). */
+        vvdecAccessUnit fau = { 0 };
+        fau.payload = ctx->flush_buf;
+        fau.payloadSize = sizeof(ctx->flush_buf);
+        fau.payloadUsedSize = 0;
+        ret = vvdec_decode(ctx->decoder, &fau, &vframe);
+        if (vframe) {
+            ret = libvvdec_copy_frame(avctx, frame, vframe);
+            vvdec_frame_unref(ctx->decoder, vframe);
+            if (ret < 0)
+                return ret;
+            *got_frame = 1;
+        }
+    }
+
+    return 0;
+}
+
+static const AVOption libvvdec_options[] = {
+    { "parse_delay", "number of frames to parse in parallel",
+      offsetof(LibvvdecContext, parse_delay), AV_OPT_TYPE_INT,
+      { .i64 = -1 }, -1, INT_MAX, AV_OPT_FLAG_VIDEO_PARAM | AV_OPT_FLAG_DECODING_PARAM },
+    { NULL },
+};
+
+static const AVClass libvvdec_class = {
+    .class_name = "libvvdec decoder",
+    .item_name  = av_default_item_name,
+    .option     = libvvdec_options,
+    .version    = LIBAVUTIL_VERSION_INT,
+};
+
+const FFCodec ff_libvvdec_decoder = {
+    .p.name         = "libvvdec",
+    .p.long_name    = NULL_IF_CONFIG_SMALL("VVC (Versatile Video Coding) via vvdec"),
+    .p.type         = AVMEDIA_TYPE_VIDEO,
+    .p.id           = AV_CODEC_ID_VVC,
+    .priv_data_size = sizeof(LibvvdecContext),
+    .init           = libvvdec_init,
+    .close          = libvvdec_close,
+    FF_CODEC_DECODE_CB(libvvdec_decode),
+    .flush          = libvvdec_flush,
+    .p.capabilities = AV_CODEC_CAP_DR1 | AV_CODEC_CAP_DELAY | AV_CODEC_CAP_OTHER_THREADS,
+    .caps_internal  = FF_CODEC_CAP_AUTO_THREADS,
+    CODEC_PIXFMTS(AV_PIX_FMT_YUV420P, AV_PIX_FMT_YUV420P10LE, AV_PIX_FMT_YUV420P12LE,
+                  AV_PIX_FMT_YUV422P, AV_PIX_FMT_YUV422P10LE, AV_PIX_FMT_YUV422P12LE,
+                  AV_PIX_FMT_YUV444P, AV_PIX_FMT_YUV444P10LE, AV_PIX_FMT_YUV444P12LE),
+    .p.priv_class   = &libvvdec_class,
+    .p.wrapper_name = "libvvdec",
+};
