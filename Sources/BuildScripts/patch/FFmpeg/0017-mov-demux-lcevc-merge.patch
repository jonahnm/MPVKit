+    {
+        uint8_t *dst = buf;
+        for (p = el_pkt->data, remaining = el_pkt->size; remaining > 0;) {
+            int nalsize;
+            if (nal_length_size == 4 && remaining >= 4) {
+                nalsize = AV_RB32(p);
+                p += 4;
+            } else if (nal_length_size == 2 && remaining >= 2) {
+                nalsize = AV_RB16(p);
