+static void mov_lcevc_merge_packet(AVFormatContext *s, AVPacket *base_pkt,
+                                   const AVPacket *el_pkt)
+{
+    int nal_length_size = 0;
+    const uint8_t *p;
+    int remaining;
+    uint8_t *buf;
+    size_t size = 0;
+
+    if (el_pkt->size <= 0)
+        return;
+
+    /* The lvc1 sample entry carries an avcC-like config with the NAL length
+     * size at the same offset the lcevc_merge filter reads; fall back to
+     * auto-detection when the demuxer did not surface extradata. */
+    if (s->streams[el_pkt->stream_index]->codecpar->extradata_size > 4 &&
+        s->streams[el_pkt->stream_index]->codecpar->extradata[0])
+        nal_length_size = (s->streams[el_pkt->stream_index]->codecpar->extradata[4] >> 6) + 1;
+    else if (el_pkt->size > 4 && AV_RB32(el_pkt->data) == el_pkt->size - 4)
+        nal_length_size = 4;
+    else if (el_pkt->size > 2 && AV_RB16(el_pkt->data) == el_pkt->size - 2)
+        nal_length_size = 2;
+
+    p = el_pkt->data;
+    remaining = el_pkt->size;
+    if (nal_length_size) {
+        while (remaining >= nal_length_size) {
+            int nal_size = nal_length_size == 4 ? AV_RB32(p) : AV_RB16(p);
+            p += nal_length_size;
+            remaining -= nal_length_size;
+            if (nal_size < 0 || nal_size > remaining || nal_size > INT_MAX - 4)
+                return;
+            size += nal_size + 4;
+            p += nal_size;
+            remaining -= nal_size;
+        }
