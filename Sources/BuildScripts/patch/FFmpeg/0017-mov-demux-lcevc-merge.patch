+            return;
+
+        buf = av_packet_new_side_data(base_pkt, AV_PKT_DATA_LCEVC, size);
+        if (!buf)
+            return;
+        p = el_pkt->data;
+        remaining = el_pkt->size;
+        while (remaining >= nal_length_size) {
+            int nal_size = nal_length_size == 4 ? AV_RB32(p) : AV_RB16(p);
+            p += nal_length_size;
+            remaining -= nal_length_size;
+            AV_WB32(buf, 1);
+            memcpy(buf + 4, p, nal_size);
+            buf += 4 + nal_size;
+            p += nal_size;
+            remaining -= nal_size;
+        }
